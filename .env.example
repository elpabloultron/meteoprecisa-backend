# ======================================================================
# METEOPRECISA CHILE - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ======================================================================

# ----------------------------------------------------------------------
# 1. Dirección Meteorológica de Chile (DMC) - Credenciales de API
# ----------------------------------------------------------------------
USUARIO_DMC=tu_correo_registrado_dmc@correo.com
TOKEN_DMC=tu_token_privado_dmc_aqui

# ----------------------------------------------------------------------
# 2. Google Earth Engine (GEE) & Google Cloud Platform (GCP)
# ----------------------------------------------------------------------
# En Cloud Run (Producción): No se requieren claves locales, se utiliza
# Application Default Credentials (ADC) nativo asignado al contenedor GCP.

# En Desarrollo Local: Especificar la ruta a la llave JSON de la Service Account
GOOGLE_APPLICATION_CREDENTIALS=./llave-google.json
GEE_KEY_PATH=./llave-google.json
GCP_PROJECT_ID=gen-lang-client-0695066948

# ----------------------------------------------------------------------
# 3. Servidor Web & Entorno de Ejecución
# ----------------------------------------------------------------------
PORT=8000
ENVIRONMENT=production